module Tests.GenericSpecialization

identity<T> :: T (value : T) {
  return value
}

Box<T> :: artifact {
  value : T

  get :: T () {
    return self.value
  }
}

Wrap<T> :: artifact {
  box : Box<T>
}

twice<T> :: T (value : T) {
  return identity(identity(value))
}

main :: i32 () {
  wrapped : Wrap<i32> = { { twice(42) } }
  ok :: bool = identity<bool>(true)
  if (!ok) { return 1 }
  return wrapped.box.get()
}
