import Standard.FS
using Standard.FS

main : i32 () {
  path : string = "/tmp/simple_reserved_fs_using.txt"
  remove(path)
  if (!writeText(path, "abc")) { return 0 }
  text : string = readText(path)
  if (len(text) != 3) { return 0 }
  bytes : i32[] = readBytes(path)
  if (len(bytes) != 3 || bytes[1] != 98) { return 0 }
  entries : string[] = listDir("tests/simple")
  if (len(entries) == 0) { return 0 }
  if (!remove(path)) { return 0 }
  return 1
}
