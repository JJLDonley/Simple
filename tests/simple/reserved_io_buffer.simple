import System.Bytes

main : () -> i32 {
  src : i32[] = System.Bytes.new(4)
  dst : i32[] = System.Bytes.new(4)
  if (System.Bytes.len(src) != 4) { return 1 }
  if (!System.Bytes.writeU16LE(src, 0, 1799)) { return 2 }
  if (System.Bytes.copy(dst, 0, src, 0, 4) != 4) { return 3 }
  if (System.Bytes.readU16LE(dst, 0) != 1799) { return 4 }
  return 0
}
