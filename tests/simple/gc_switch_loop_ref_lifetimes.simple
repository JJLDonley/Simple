Box :: artifact { text : string }

main : i32 () {
  i : i32 = 0
  outer : string = "outer"
  while (i < 2500) {
    chosen : string = switch (i) {
      i % 2 == 0 => { local : string = "even"; return local }
      default => { local : string = "odd"; return local }
    }
    box : Box = { chosen }
    if (i % 2 == 0) {
      if (len(box.text) != 4) { return 1 }
    } else {
      if (len(box.text) != 3) { return 2 }
    }
    if (len(outer) != 5) { return 3 }
    i = i + 1
  }
  return 0
}
