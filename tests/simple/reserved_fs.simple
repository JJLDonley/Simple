import Standard.FS

main : i32 () {
  path : string = "build/simple_reserved_fs.txt"
  copy_path : string = "build/simple_reserved_fs_copy.txt"
  bytes_path : string = "build/simple_reserved_fs_bytes.bin"
  dir_path : string = "build/simple_reserved_fs_dir/sub"

  Standard.FS.remove(path)
  Standard.FS.remove(copy_path)
  Standard.FS.remove(bytes_path)

  if (!Standard.FS.writeText(path, "hello")) { return 0 }
  text : string = Standard.FS.readText(path)
  if (len(text) != 5) { return 0 }
  if (!Standard.FS.copy(path, copy_path)) { return 0 }
  copied : string = Standard.FS.readText(copy_path)
  if (len(copied) != 5) { return 0 }

  bytes : i32[] = [65, 66, 67]
  if (!Standard.FS.writeBytes(bytes_path, bytes)) { return 0 }
  read : i32[] = Standard.FS.readBytes(bytes_path)
  if (len(read) != 3 || read[0] != 65 || read[2] != 67) { return 0 }

  Standard.FS.remove("build/simple_reserved_fs_dir")
  if (!Standard.FS.mkdirAll(dir_path)) { return 0 }
  entries : string[] = Standard.FS.listDir("build/simple_reserved_fs_dir")
  if (len(entries) == 0) { return 0 }
  cwd : string = Standard.FS.cwd()
  if (len(cwd) == 0) { return 0 }
  if (!Standard.FS.setCwd(cwd)) { return 0 }

  Standard.FS.remove(path)
  Standard.FS.remove(copy_path)
  Standard.FS.remove(bytes_path)
  return 1
}
