import Standard.Random
import System.Random
import System.Bytes

main : i32 () {
  Standard.Random.seed(123)
  a : i32 = Standard.Random.range(5, 10)
  b : i32 = Standard.Random.i32()
  c : i64 = Standard.Random.i64()
  x : f64 = Standard.Random.f64()
  bytes : i32[] = System.Bytes.new(8)
  if (!System.Random.fillBytes(bytes)) { return 0 }
  if (a < 5 || a >= 10) { return 0 }
  if (b < 0) { return 0 }
  if (c < 0) { return 0 }
  if (x < 0.0 || x >= 1.0) { return 0 }
  return 1
}
