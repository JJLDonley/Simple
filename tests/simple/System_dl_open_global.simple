import System.FFI
import System.Env

extern ffi.simple_add_i32 : (a : i32, b : i32) -> i32

lib_path :: string = System.Env.get("SIMPLE_TEST_FFI_LIBRARY")
lib :: i64 = System.FFI.open(lib_path, ffi)

AddViaGlobal : (a : i32, b : i32) -> i32 {
  return lib.simple_add_i32(a, b)
}

main : () -> i32 {
  if (lib == 0) {
    return 0
  }
  out : i32 = AddViaGlobal(20, 22)
  System.FFI.close(lib)
  if (out == 42) {
    return 1
  }
  return 0
}
