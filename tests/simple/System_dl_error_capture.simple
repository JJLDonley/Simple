import System.FFI
import System.Env

extern ffi.simple_fail_errno : (code : i32) -> i32 capture(errno)
extern ffi.simple_fail_platform : (code : u32) -> i32 capture(platform)

main :: () -> i32 {
  path : string = System.Env.get("SIMPLE_TEST_FFI_LIBRARY")
  library : i64 = System.FFI.open(path, ffi)
  if (library == 0) { return 0 }
  if (library.simple_fail_errno(34) != -1) { return 0 }
  if (System.FFI.errno() != 34) { return 0 }
  if (library.simple_fail_platform(87) != -1) { return 0 }
  if (System.FFI.platformError() != 87) { return 0 }
  System.FFI.close(library)
  return 1
}
