Vector2 :: artifact {
    x: f32
    y: f32
}

Bullet :: artifact {
    position: Vector2
    velocity: Vector2
    alive: bool
    ttl: f32

    Update: (dt: f32) -> void {
        if (!self.alive) { return }
        self.position.x += self.velocity.x * dt
        self.position.y += self.velocity.y * dt
        self.ttl -= dt
        if (self.ttl <= 0.0) { self.alive = false }
    }
}

Asteroid :: artifact {
    position: Vector2
    size: f32
    alive: bool
}
