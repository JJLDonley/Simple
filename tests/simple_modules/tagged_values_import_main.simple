module Tests.TaggedValuesImportMain

import "./tagged_values_library.simple"

main :: i32 () {
  maybe :: i32? = RemoteTagged.choose(true, 42)
  loaded :: Result<i32, RemoteFailure> = RemoteTagged.forwarded(true)
  value : i32 = switch (maybe) {
    { present } => return present
    {} => return 0
  }
  forwarded : i32 = switch (loaded) {
    { .value = present } => return present
    { .error = error } => return 0
  }
  return value + forwarded - 42
}
