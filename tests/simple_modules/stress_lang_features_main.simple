X :: namespace {
    Base: () -> i32 { return 3 }

    Add: (a: i32, b: i32) -> i32 {
        return a + b
    }

    Mix: (a: i32, b: i32, useMul: bool) -> i32 {
        if (useMul) { return a * b }
        return a + b
    }
}

Pair :: artifact {
    a: i32
    b: i32

    Sum: () -> i32 {
        return self.a + self.b
    }

    Scale: (k: i32) -> void {
        self.a *= k
        self.b *= k
    }
}

Holder :: artifact {
    items: i32[]
    total: i32

    Add: (v: i32) -> void {
        self.items.push(v)
        self.total += v
    }

    RemoveFirst: () -> i32 {
        if (self.items.len() == 0) { return -1 }
        return self.items.remove(0)
    }
}

Y :: namespace {
    BuildHolder: (seed: i32) -> Holder {
        h : Holder = { [], 0 }
        for (i : i32 = 0; i < seed; i += 1) {
            h.Add(X.Add(i, X.Base()))
        }
        return h
    }

    SumArray: (arr: i32{4}) -> i32 {
        s : i32 = 0
        for (i : i32 = 0; i < 4; i += 1) {
            s += arr[i]
        }
        return s
    }
}

Z :: namespace {
    Run: (v: i32) -> i32 {
        p : Pair = { v, X.Base() }
        p.Scale(2)
        h : Holder = Y.BuildHolder(3)
        removed : i32 = h.RemoveFirst()
        arr : i32{4} = {1, 2, 3, 4}
        listA : i32[] = []
        listA.push(1)
        listA.push(2)
        listA.insert(1, 5)
        a : i32 = listA.remove(0)
        b : i32 = listA.pop()
        listA.push(a + b)
        c : i32 = listA.len()
        listA.clear()
        listA.push(c)
        d : i32 = listA.pop()

        total : i32 = p.Sum() + h.total + removed + Y.SumArray(arr) + a + b + c + d
        if (total > 30) {
            total = total - X.Mix(3, 4, false)
        } else {
            total = total + X.Mix(3, 4, true)
        }
        return total
    }
}

main : () -> i32 {
    return Z.Run(5)
}
