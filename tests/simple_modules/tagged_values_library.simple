module Tests.TaggedValuesLibrary

RemoteFailure :: enum {
  Rejected = 1
}

RemoteTagged :: namespace {
  choose<T> :: (accept : bool, value : T) -> T? {
    if (accept) { return { value } }
    return {}
  }

  load :: (accept : bool) -> Result<i32, RemoteFailure> {
    if (accept) { return { .value = 40 } }
    return { .error = RemoteFailure.Rejected }
  }

  forwarded :: (accept : bool) -> Result<i32, RemoteFailure> {
    value : i32 = RemoteTagged.load(accept)?
    return { .value = value + 2 }
  }
}
