module Tests.Projects.Traffic.Model

Signal :: enum {
  Red = 0,
  Green = 1,
  Yellow = 2
}

Intersection :: artifact {
  name : string
  signal : Signal
  ticks : i32
  carsPassed : i32
}

TrafficError :: enum {
  InvalidDemand = 0
}

TrafficModel :: namespace {
  nextSignal :: (current : Signal) -> Signal {
    if (current == Signal.Red) { return Signal.Green }
    if (current == Signal.Green) { return Signal.Yellow }
    return Signal.Red
  }
}
