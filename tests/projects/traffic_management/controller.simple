module Tests.Projects.Traffic.Controller

import "./model.simple"

computeWindow :: async Result<i32, TrafficError> (
    demand : i32,
    policy : fn i32 (i32)) {
  if (demand < 0) { return { .error = TrafficError.InvalidDemand } }
  return { .value = policy(demand) }
}

advance :: async Result<i32, TrafficError> (
    intersection : Intersection,
    demand : i32,
    policy : fn i32 (i32)) {
  window : i32 = await computeWindow(demand, policy)?
  intersection.signal = TrafficModel.nextSignal(intersection.signal)
  intersection.ticks += window
  if (intersection.signal == Signal.Green) {
    intersection.carsPassed += demand
  }
  return { .value = window }
}

runCycle :: async Result<i32, TrafficError> (
    intersections : Intersection[],
    demands : i32[],
    policy : fn i32 (i32)) {
  pending : Promise<Result<i32, TrafficError>>[] = []
  for (i : i32 = 0; i < intersections.len(); i += 1) {
    pending.push(advance(intersections[i], demands[i], policy))
  }
  total : i32 = 0
  for (i : i32 = 0; i < pending.len(); i += 1) {
    total += await pending[i]?
  }
  return { .value = total }
}

PolicySet :: artifact {
  apply : fn i32 (i32)
  observations : fn i32 ()
}

makePolicy :: PolicySet (bias : i32) {
  observations : i32 = 0
  return {
    (demand) {
      observations += 1
      return demand + bias
    },
    () { return observations }
  }
}
