module Tests.Stress.SpectralNorm

import Standard.Math

matrixValue :: (i : i32, j : i32) -> f64 {
  sum :: i32 = i + j
  denominator :: i32 = (sum * (sum + 1) / 2) + i + 1
  return 1.0 / @f64(denominator)
}

multiplyAv :: (input : f64[], output : f64[], size : i32) -> void {
  for (i : i32 = 0; i < size; i += 1) {
    value : f64 = 0.0
    for (j : i32 = 0; j < size; j += 1) {
      value += matrixValue(i, j) * input[j]
    }
    output[i] = value
  }
}

multiplyAtv :: (input : f64[], output : f64[], size : i32) -> void {
  for (i : i32 = 0; i < size; i += 1) {
    value : f64 = 0.0
    for (j : i32 = 0; j < size; j += 1) {
      value += matrixValue(j, i) * input[j]
    }
    output[i] = value
  }
}

multiplyAtAv :: (input : f64[], output : f64[], temporary : f64[], size : i32) -> void {
  multiplyAv(input, temporary, size)
  multiplyAtv(temporary, output, size)
}

main :: () -> i32 {
  size :: i32 = 60
  u : f64[] = []
  v : f64[] = []
  temporary : f64[] = []
  for (i : i32 = 0; i < size; i += 1) {
    u.push(1.0)
    v.push(0.0)
    temporary.push(0.0)
  }

  for (iteration : i32 = 0; iteration < 10; iteration += 1) {
    multiplyAtAv(u, v, temporary, size)
    multiplyAtAv(v, u, temporary, size)
  }

  numerator : f64 = 0.0
  denominator : f64 = 0.0
  for (i : i32 = 0; i < size; i += 1) {
    numerator += u[i] * v[i]
    denominator += v[i] * v[i]
  }
  norm :: f64 = Standard.Math.sqrt(numerator / denominator)
  if (norm < 1.2741 || norm > 1.2743) { return 1 }
  return 0
}
