module Tests.Stress.ModuleGenericComposition

Box<T> :: artifact {
  value : T

  get :: () -> T { return self.value }
}

GenericOps :: namespace {
  identity<T> :: (value : T) -> T {
    return value
  }

  select<T> :: (values : T[], index : i32) -> T {
    return GenericOps.identity(values[index])
  }

  boxAgain<T> :: (box : Box<T>) -> Box<T> {
    return GenericOps.identity(box)
  }
}

main :: () -> i32 {
  values : i32[] = []
  for (i : i32 = 0; i < 2000; i += 1) {
    values.push(i * 2)
  }
  if (GenericOps.select(values, 1234) != 2468) { return 1 }

  large : i64[] = [10000000000, 20000000000, 30000000000]
  if (GenericOps.select(large, 2) != 30000000000) { return 2 }

  original : Box<i32> = { 42 }
  copied :: Box<i32> = GenericOps.boxAgain(original)
  if (copied.get() != 42) { return 3 }
  return 0
}
