module Tests.Stress.GenericMethods

Box<T> :: class {
  value : T

  choose<U> :: (other : U) -> U {
    return other
  }

  keep<U> :: (ignored : U) -> T {
    return self.value
  }

  keepRecursive<U> :: (fallback : U, count : i32) -> T {
    if (count == 0) { return self.value }
    return self.keepRecursive(fallback, count - 1)
  }

  answer :: () -> i32 {
    return self.choose(42)
  }
}

Router :: class {
  echo<T> :: (value : T) -> T {
    return value
  }
}

Holder :: class {
  box : Box<i32>
}

Relay :: class {
  ping<T> :: (value : T, count : i32) -> T {
    if (count == 0) { return value }
    return self.pong(value, count - 1)
  }

  pong<T> :: (value : T, count : i32) -> T {
    if (count == 0) { return value }
    return self.ping(value, count - 1)
  }
}

main :: () -> i32 {
  box : Box<i32> = { 40 }
  total : i32 = 0
  for (i : i32 = 0; i < 1000; i += 1) {
    total += box.choose(i)
  }
  if (total != 499500) { return 1 }

  yes :: bool = box.choose(true)
  if (!yes) { return 2 }

  boxes : Box<i32>[] = [box]
  if (boxes[0].choose(2) != 2) { return 3 }

  holder : Holder = { box }
  if (!holder.box.choose(true)) { return 4 }

  router : Router = {}
  left :: i32 = router.echo(20)
  right :: i32 = router.echo(22)
  if (left + right != 42) { return 5 }

  if (box.keepRecursive(false, 100) != 40) { return 6 }
  relay : Relay = {}
  if (relay.ping(42, 100) != 42) { return 7 }
  if (box.answer() != 42) { return 8 }

  return box.keep(false) + boxes[0].choose(2) - 42
}
