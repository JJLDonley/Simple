module Tests.Stress.GenericChains

Box<T> :: artifact {
  value : T

  choose<U> :: (other : U) -> U {
    return other
  }

  selfBox :: () -> Box<T> {
    return self
  }
}

makeBox<T> :: (value : T) -> Box<T> {
  return { value }
}

Factory :: namespace {
  make<T> :: (value : T) -> Box<T> {
    return { value }
  }
}

main :: () -> i32 {
  total : i32 = 0
  for (i : i32 = 0; i < 1000; i += 1) {
    total += Factory.make(i).choose(i)
  }
  if (total != 499500) { return 1 }

  box : Box<i32> = { 7 }
  if (box.selfBox().choose(42) != 42) { return 2 }
  if (makeBox(1).choose(21) + Factory.make(2).choose(21) != 42) { return 3 }

  word :: string = Factory.make("alpha").choose("beta")
  if (word != "beta") { return 4 }
  return 0
}
