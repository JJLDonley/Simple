module Tests.Stress.TaggedLayouts

Holder<T> :: artifact {
  value : T
}

identity<T> :: T (value : T) {
  return value
}

main :: i32 () {
  option : Option<string>
  result : Result<Option<i32>, string>
  options : Holder<Option<string>>[] = []
  results : Holder<Result<Option<i32>, string>>[] = []

  for (i : i32 = 0; i < 2000; i += 1) {
    optionHolder : Holder<Option<string>> = { identity(option) }
    resultHolder : Holder<Result<Option<i32>, string>> = { identity(result) }
    options.push(optionHolder)
    results.push(resultHolder)
  }

  if (options.len() != 2000) { return 1 }
  if (results.len() != 2000) { return 2 }
  return 0
}
