import Standard.Log
import System.Log
import Standard.FS

main : i32 () {
  path : string = "build/test_reserved_log.txt"
  Standard.Log.setLevel(3)
  Standard.Log.info("hidden")
  Standard.Log.warn("hidden")
  Standard.Log.error("shown")
  System.Log.log(3, "also shown")
  if (!Standard.Log.setFile(path)) { return 0 }
  Standard.Log.error("file shown")
  System.Log.log(3, "file also shown")
  if (!System.Log.flush()) { return 0 }
  if (!Standard.FS.exists(path)) { return 1 }
  Standard.Log.setFile("")
  Standard.Log.setLevel(0)
  return 0
}
