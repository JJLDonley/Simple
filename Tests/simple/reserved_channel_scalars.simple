import Channel

main : i32 () {
  i64ch : i64 = Channel.newI64()
  f32ch : i64 = Channel.newF32()
  f64ch : i64 = Channel.newF64()
  boolch : i64 = Channel.newBool()

  Channel.sendI64(i64ch, 40)
  Channel.sendF32(f32ch, 1.5)
  Channel.sendF64(f64ch, 2.5)
  Channel.sendBool(boolch, true)

  a : i64 = Channel.recvI64(i64ch)
  b : f32 = Channel.recvF32(f32ch)
  c : f64 = Channel.recvF64(f64ch)
  d : bool = Channel.recvBool(boolch)

  Channel.close(i64ch)
  Channel.close(f32ch)
  Channel.close(f64ch)
  Channel.close(boolch)

  if (!d) { return 0 }
  return @i32(a) + @i32(b) + @i32(c)
}
