import System.Bytes

main : i32 () {
  b : i32[] = System.Bytes.new(8)
  if (System.Bytes.len(b) != 8) { return 1 }
  if (!System.Bytes.writeU16LE(b, 0, 4660)) { return 2 }
  if (System.Bytes.readU16LE(b, 0) != 4660) { return 3 }
  if (!System.Bytes.writeU32LE(b, 2, 305419896)) { return 4 }
  if (System.Bytes.readU32LE(b, 2) != 305419896) { return 5 }
  s : i32[] = System.Bytes.slice(b, 2, 4)
  if (System.Bytes.len(s) != 4) { return 6 }
  if (System.Bytes.readU32LE(s, 0) != 305419896) { return 7 }
  dst : i32[] = System.Bytes.new(4)
  if (System.Bytes.copy(dst, 0, b, 2, 4) != 4) { return 8 }
  if (System.Bytes.readU32LE(dst, 0) != 305419896) { return 9 }
  if (System.Bytes.writeU32LE(dst, 2, 1)) { return 10 }
  return 0
}
