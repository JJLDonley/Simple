{
  "name": "simple-vscode",
  "displayName": "Simple Language",
  "description": "VS Code support for the Simple language (LSP + syntax highlighting)",
  "version": "0.4.42",
  "publisher": "jjldonley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JJLDonley/Simple.git",
    "directory": "Editor/vscode-simple"
  },
  "homepage": "https://github.com/JJLDonley/Simple/tree/main/Editor/vscode-simple",
  "bugs": {
    "url": "https://github.com/JJLDonley/Simple/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "simple",
        "aliases": [
          "Simple",
          "simple"
        ],
        "extensions": [
          ".simple",
          ".sir",
          ".sbc"
        ],
        "semanticHighlighting": true,
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "simple",
        "scopeName": "source.simple",
        "path": "./syntaxes/simple.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "simple",
        "scopes": {
          "function": ["entity.name.function.simple"],
          "function.declaration": ["entity.name.function.declaration.simple"],
          "type": ["support.type.simple"],
          "type.declaration": ["entity.name.type.declaration.simple"],
          "variable.declaration": ["variable.other.definition.simple"],
          "parameter": ["variable.parameter.simple"],
          "property": ["variable.other.property.simple"],
          "namespace": ["entity.name.namespace.simple"]
        }
      }
    ],
    "configurationDefaults": {
      "[simple]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "function.declaration:simple": { "foreground": "#DCDCAA" },
          "function:simple": { "foreground": "#DCDCAA" },
          "type:simple": { "foreground": "#4EC9B0" },
          "type.declaration:simple": { "foreground": "#4EC9B0" },
          "variable.declaration:simple": { "foreground": "#9CDCFE" },
          "parameter:simple": { "foreground": "#9CDCFE" },
          "property:simple": { "foreground": "#9CDCFE" },
          "namespace:simple": { "foreground": "#4EC9B0" }
        }
      }
    },
    "commands": [
      {
        "command": "simple.checkCurrentFile",
        "title": "Simple: Check Current File",
        "category": "Simple",
        "icon": "$(check)"
      },
      {
        "command": "simple.runCurrentFile",
        "title": "Simple: Run Current File",
        "category": "Simple",
        "icon": "$(play)"
      },
      {
        "command": "simple.runCurrentFileWithJit",
        "title": "Simple: Run Current File With JIT",
        "category": "Simple",
        "icon": "$(rocket)"
      },
      {
        "command": "simple.buildCurrentFile",
        "title": "Simple: Build Current File",
        "category": "Simple",
        "icon": "$(package)"
      },
      {
        "command": "simple.compileCurrentFile",
        "title": "Simple: Compile Current File",
        "category": "Simple",
        "icon": "$(gear)"
      },
      {
        "command": "simple.emitSir",
        "title": "Simple: Emit SIR",
        "category": "Simple"
      },
      {
        "command": "simple.emitSbc",
        "title": "Simple: Emit SBC",
        "category": "Simple"
      },
      {
        "command": "simple.restartLanguageServer",
        "title": "Simple: Restart Language Server",
        "category": "Simple",
        "icon": "$(debug-restart)"
      },
      {
        "command": "simple.showLanguageServerOutput",
        "title": "Simple: Show Language Server Output",
        "category": "Simple"
      },
      {
        "command": "simple.showVersion",
        "title": "Simple: Show svm Version",
        "category": "Simple"
      },
      {
        "command": "simple.showHelp",
        "title": "Simple: Show svm Help",
        "category": "Simple"
      },
      {
        "command": "simple.configureCompilerPath",
        "title": "Simple: Configure Compiler Path",
        "category": "Simple"
      },
      {
        "command": "simple.configureOutputDirectory",
        "title": "Simple: Configure Output Directory",
        "category": "Simple"
      },
      {
        "command": "simple.toggleJitDefault",
        "title": "Simple: Toggle JIT Default",
        "category": "Simple",
        "icon": "$(rocket)"
      },
      {
        "command": "simple.toggleTrace",
        "title": "Simple: Toggle Trace",
        "category": "Simple",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "simple.checkCurrentFile"
        },
        {
          "command": "simple.runCurrentFile"
        },
        {
          "command": "simple.runCurrentFileWithJit"
        },
        {
          "command": "simple.buildCurrentFile"
        },
        {
          "command": "simple.compileCurrentFile"
        },
        {
          "command": "simple.emitSir"
        },
        {
          "command": "simple.emitSbc"
        },
        {
          "command": "simple.restartLanguageServer"
        },
        {
          "command": "simple.showLanguageServerOutput"
        },
        {
          "command": "simple.showVersion"
        },
        {
          "command": "simple.showHelp"
        },
        {
          "command": "simple.configureCompilerPath"
        },
        {
          "command": "simple.configureOutputDirectory"
        },
        {
          "command": "simple.toggleJitDefault"
        },
        {
          "command": "simple.toggleTrace"
        }
      ],
      "editor/title": [
        {
          "command": "simple.runCurrentFile",
          "when": "editorLangId == simple",
          "group": "navigation@10"
        },
        {
          "command": "simple.checkCurrentFile",
          "when": "editorLangId == simple",
          "group": "navigation@20"
        },
        {
          "command": "simple.restartLanguageServer",
          "when": "editorLangId == simple",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "command": "simple.checkCurrentFile",
          "when": "editorLangId == simple",
          "group": "simple@10"
        },
        {
          "command": "simple.runCurrentFile",
          "when": "editorLangId == simple",
          "group": "simple@20"
        },
        {
          "command": "simple.runCurrentFileWithJit",
          "when": "editorLangId == simple",
          "group": "simple@30"
        },
        {
          "command": "simple.emitSir",
          "when": "editorLangId == simple",
          "group": "simple@40"
        },
        {
          "command": "simple.emitSbc",
          "when": "editorLangId == simple",
          "group": "simple@50"
        }
      ],
      "explorer/context": [
        {
          "command": "simple.checkCurrentFile",
          "when": "resourceExtname == .simple || resourceExtname == .sir || resourceExtname == .sbc",
          "group": "simple@10"
        },
        {
          "command": "simple.runCurrentFile",
          "when": "resourceExtname == .simple || resourceExtname == .sir || resourceExtname == .sbc",
          "group": "simple@20"
        },
        {
          "command": "simple.runCurrentFileWithJit",
          "when": "resourceExtname == .simple || resourceExtname == .sir || resourceExtname == .sbc",
          "group": "simple@30"
        },
        {
          "command": "simple.buildCurrentFile",
          "when": "resourceExtname == .simple || resourceExtname == .sir",
          "group": "simple@40"
        },
        {
          "command": "simple.compileCurrentFile",
          "when": "resourceExtname == .simple || resourceExtname == .sir",
          "group": "simple@45"
        },
        {
          "command": "simple.emitSir",
          "when": "resourceExtname == .simple",
          "group": "simple@50"
        },
        {
          "command": "simple.emitSbc",
          "when": "resourceExtname == .simple || resourceExtname == .sir",
          "group": "simple@60"
        }
      ]
    },
    "configuration": {
      "title": "Simple",
      "properties": {
        "simple.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the svm executable. Empty means discover bundled svm, then PATH svm."
        },
        "simple.lspArgs": {
          "type": "array",
          "default": [
            "lsp"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to svm to start the Simple LSP server."
        },
        "simple.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory for generated build/SIR/SBC outputs. Relative paths resolve from the workspace folder."
        },
        "simple.jitByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Run Simple files with -jit --jit-stats from the default Run command."
        },
        "simple.trace": {
          "type": "boolean",
          "default": false,
          "description": "Enable Simple trace environment variables for svm commands and the LSP server."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "simple",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "svm subcommand, such as check, run, build, or emit."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments after the svm subcommand."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "simple-svm",
        "owner": "simple",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "package": "npm run sync-version && vsce package",
    "vscode:prepublish": "npm run sync-version && npm run compile",
    "validate": "npm run sync-version && npm run compile && node scripts/validate-extension.js",
    "install:vsix": "code --install-extension simple-vscode.vsix --force",
    "sync-version": "node scripts/sync-version.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "5.4.5"
  },
  "activationEvents": [
    "onLanguage:simple",
    "onCommand:simple.restartLanguageServer",
    "onCommand:simple.checkCurrentFile",
    "onCommand:simple.runCurrentFile",
    "onCommand:simple.runCurrentFileWithJit",
    "onCommand:simple.buildCurrentFile",
    "onCommand:simple.compileCurrentFile",
    "onCommand:simple.emitSir",
    "onCommand:simple.emitSbc",
    "onCommand:simple.showLanguageServerOutput",
    "onCommand:simple.showVersion",
    "onCommand:simple.showHelp",
    "onCommand:simple.configureCompilerPath",
    "onCommand:simple.configureOutputDirectory",
    "onCommand:simple.toggleJitDefault",
    "onCommand:simple.toggleTrace"
  ]
}
